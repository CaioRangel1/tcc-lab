# Modo de operação do laboratório:
#   perimetro  -> uma credencial válida basta para operar (linha de base)
#   zero_trust -> controles zero trust ativos
MODO=zero_trust

# Horário usado pelas regras de contexto (formato HH:MM).
# Deixe vazio para usar o horário real. Ex.: HORA_SIMULADA=03:00 simula o ataque de madrugada.
HORA_SIMULADA=03:00

# Saldo inicial da conta reserva fictícia (em reais)
SALDO_INICIAL=1000000000
